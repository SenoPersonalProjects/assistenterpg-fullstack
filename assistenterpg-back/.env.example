# Copie este arquivo para .env antes de rodar o backend localmente.
# Opcionalmente, use .env.local para sobrescrever valores locais sem tocar no .env.
# Nao use estes valores em producao.

NODE_ENV=development
PORT=3000
PORT_AUTO_RETRY=true
PORT_AUTO_RETRY_MAX=10
API_VERSION=v1

DATABASE_URL="mysql://assistenterpg:assistenterpg_dev@localhost:3306/assistenterpg"

FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
SWAGGER_ENABLED=true

JWT_SECRET=troque-este-secret-local-com-pelo-menos-32-caracteres
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
AUTH_BEARER_FALLBACK_ENABLED=false
# Use 1 no Render/reverse proxy confiavel e 0 localmente.
TRUST_PROXY_HOPS=0
AUTH_RATE_LIMIT_HASH_SECRET=troque-este-segredo-local-com-pelo-menos-32-caracteres

AUTH_EMAIL_MODE=console
AUTH_EMAIL_FROM=
AUTH_EMAIL_FROM_NAME=AssistenteRPG
AUTH_RESET_TOKEN_TTL_MINUTES=30
AUTH_VERIFY_TOKEN_TTL_MINUTES=1440
AUTH_PENDING_REGISTRATION_TTL_HOURS=168
AUTH_EMAIL_CHANGE_TOKEN_TTL_MINUTES=30
AUTH_ACCOUNT_DELETION_GRACE_DAYS=90
AUTH_WS_SESSION_RECHECK_SECONDS=30
AUTH_SECURITY_CLEANUP_INTERVAL_MINUTES=15
AUTH_SECURITY_RETENTION_DAYS=7

# SMTP opcional quando AUTH_EMAIL_MODE=smtp
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_SECURE=false
AUTH_SMTP_USER=
AUTH_SMTP_PASS=

# Resend opcional quando AUTH_EMAIL_MODE=resend
RESEND_API_KEY=

PRISMA_PREBUILD_AUTO_GENERATE=true

# Google OAuth/Calendar opcionais
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_OAUTH_SCOPES=openid email profile
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.events
GOOGLE_TOKEN_ENCRYPTION_KEY=troque-este-segredo-google-local-com-pelo-menos-32-caracteres
GOOGLE_OAUTH_STATE_TTL_MINUTES=10

# Agendamento de sessões
SESSION_SCHEDULER_ENABLED=true
SESSION_SCHEDULER_INTERVAL_MS=60000
SESSION_SCHEDULER_BATCH_SIZE=20
SESSION_LAZY_ACTIVATION_ENABLED=true
