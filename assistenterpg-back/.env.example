# Copie este arquivo para .env antes de rodar localmente.
# Nao use estes valores em producao.

NODE_ENV=development
PORT=3000
PORT_AUTO_RETRY=true
PORT_AUTO_RETRY_MAX=10

DATABASE_URL="mysql://assistenterpg:assistenterpg_dev@localhost:3306/assistenterpg"

FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
SWAGGER_ENABLED=true

JWT_SECRET=troque-este-secret-local-com-pelo-menos-32-caracteres
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
AUTH_BEARER_FALLBACK_ENABLED=false

AUTH_EMAIL_MODE=console
AUTH_EMAIL_FROM=
AUTH_EMAIL_FROM_NAME=AssistenteRPG
AUTH_RESET_TOKEN_TTL_MINUTES=30
AUTH_VERIFY_TOKEN_TTL_MINUTES=1440

# SMTP opcional quando AUTH_EMAIL_MODE=smtp
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_SECURE=false
AUTH_SMTP_USER=
AUTH_SMTP_PASS=

# Resend opcional quando AUTH_EMAIL_MODE=resend
RESEND_API_KEY=

PRISMA_PREBUILD_AUTO_GENERATE=true
